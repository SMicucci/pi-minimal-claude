{
  "name": "pi-minimal-claude",
  "version": "0.1.0",
  "description": "Pi package with planner/worker/explorer/debugger agents and manual|code-only|auto approval modes",
  "type": "module",
  "license": "MIT",
  "author": "SMicucci",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SMicucci/pi-minimal-claude.git"
  },
  "homepage": "https://github.com/SMicucci/pi-minimal-claude#readme",
  "bugs": {
    "url": "https://github.com/SMicucci/pi-minimal-claude/issues"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "agents",
    "agent-modes",
    "approval",
    "claude-code"
  ],
  "files": [
    "agents",
    "extensions",
    "LICENSE",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ],
    "subagents": {
      "agents": [
        "./agents"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node test/smoke.mjs && node test/load.mjs",
    "test:smoke": "node test/smoke.mjs",
    "test:load": "node test/load.mjs",
    "publish:check": "node scripts/publish-check.mjs",
    "publish:check:strict": "node scripts/publish-check.mjs --strict",
    "prepublishOnly": "npm run typecheck && npm test && npm run publish:check"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-coding-agent": "1.3.0",
    "@types/node": "^24.0.0",
    "jiti": "2.7.0",
    "typebox": "1.4.2",
    "typescript": "^5.9.0"
  }
}
